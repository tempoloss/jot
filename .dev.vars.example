# Copy to .dev.vars and fill in. .dev.vars is gitignored.
# The same file is read by `wrangler dev`, so one format covers both modes.

# From @BotFather
TELEGRAM_TOKEN=

# Fine-grained PAT, Issues: Read and write, scoped to the task repo only.
# Note: Repository access and Permissions are two separate sections, and the
# Update token button at the bottom is easy to miss.
GH_PAT=

# A PRIVATE repository, separate from the one holding this code.
# Point this at a public repo and every personal note becomes public.
TASK_REPO=you/tasks

# Your Telegram user id. Message the bot, then read result[0].message.chat.id
# from https://api.telegram.org/bot<TOKEN>/getUpdates
OWNER_CHAT_ID=

# Optional. GitHub notifications forwarded to Telegram on a schedule.
#
# This one is a CLASSIC token with the `notifications` scope and nothing else.
# GitHub's notification endpoints reject fine-grained tokens outright, so GH_PAT
# above cannot be reused here however it is scoped. The scope grants the
# notification list and nothing more: no repository read, no write.
#
# Leave empty and the schedule does nothing.
GH_NOTIFY_TOKEN=

# Your GitHub login. Used to drop notifications your own comments produced, and
# to tell an actual @mention from a reply in a thread you were once tagged in.
GH_LOGIN=
